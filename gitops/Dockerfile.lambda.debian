ARG IMAGE_REPOSITORY=infraweave-io/infraweave
FROM ghcr.io/${IMAGE_REPOSITORY}/cc-debian12:latest
ARG TARGETOS
ARG TARGETARCH

COPY --chmod=+x binaries/gitops-${TARGETOS}-${TARGETARCH}-musl /usr/local/bin/bootstrap

# Lambda requires this
ENV AWS_LAMBDA_RUNTIME_API="aws-runtime-interface.emulator"

# Expose the Lambda runtime port
EXPOSE 8080

# Entry point to the Lambda runtime API
ENTRYPOINT ["/usr/local/bin/bootstrap"]