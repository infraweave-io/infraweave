ARG IMAGE_REPOSITORY=infraweave-io/infraweave
ARG LAMBDA_WEB_ADAPTER_VERSION=1.0.0

FROM ghcr.io/${IMAGE_REPOSITORY}/aws-lambda-adapter:${LAMBDA_WEB_ADAPTER_VERSION} AS lambda-adapter

FROM ghcr.io/${IMAGE_REPOSITORY}/cc-debian12:latest
ARG TARGETOS
ARG TARGETARCH

COPY --from=lambda-adapter /lambda-adapter /opt/extensions/lambda-adapter
COPY --chmod=+x binaries/infraweave-chat-${TARGETOS}-${TARGETARCH}-musl /usr/local/bin/infraweave-chat

# Lambda Web Adapter forwards Lambda invocations to this local HTTP server.
ENV PORT=8090
ENV AWS_LWA_PORT=8090
ENV AWS_LWA_INVOKE_MODE=buffered
ENV AWS_LWA_ASYNC_INIT=false
ENV AWS_LWA_READINESS_CHECK_PROTOCOL=tcp
ENV AWS_LWA_PASS_THROUGH_PATH=/events

EXPOSE 8090

CMD ["infraweave-chat"]
